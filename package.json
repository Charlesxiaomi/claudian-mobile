{
  "name": "claudian-mobile",
  "version": "0.4.1",
  "description": "Claudian Mobile - a minimal AI vault agent for Obsidian, including mobile",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/build-css.mjs && node esbuild.config.mjs",
    "build": "node scripts/build-css.mjs && node esbuild.config.mjs production",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "ai",
    "mobile"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "obsidian": "latest",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
